#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_UK

// The editor is a real DS_CONTROL child dialog so the host dialog manager
// (REAPER's FX window) recurses into it for Tab navigation and initial
// focus. All controls are created programmatically in tonetrace_win32_editor.cpp.
IDD_TONETRACE_EDITOR DIALOGEX 0, 0, 980, 640
STYLE DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Tone Trace EQ"
BEGIN
END


// Less frequently changed controls live in a standard modal dialog rather than
// crowding the Match page. These remain normal CLAP parameters as well, so the
// dialog is an additional native route, not an accessibility-only surface.
IDD_TONETRACE_OPTIONS DIALOGEX 0, 0, 300, 210
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Tone Trace EQ Options"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "Full Correction Range", IDC_OPTION_FULL_RANGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 14, 160, 12
    CONTROL         "Tone Notifications", IDC_OPTION_TONE_NOTIFICATIONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 44, 150, 12
    LTEXT           "Confidence Tone Volume", -1, 14, 73, 118, 10
    EDITTEXT        IDC_OPTION_TONE_LEVEL, 142, 68, 104, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "Bypass", IDC_OPTION_BYPASS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 102, 90, 12
    PUSHBUTTON      "Reset Tone Trace...", IDC_OPTION_RESET, 14, 132, 112, 20, WS_TABSTOP
    LTEXT           "Reset clears the learned match and manual band edits.", -1, 138, 129, 148, 28
    DEFPUSHBUTTON   "OK", IDOK, 174, 181, 52, 19
    PUSHBUTTON      "Cancel", IDCANCEL, 234, 181, 52, 19
END
